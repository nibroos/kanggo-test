# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit the real .env (policy §9).
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4088
LOG_LEVEL=info

# --- Database (MySQL) ------------------------------------------------------
# Use DB_HOST=mysql when running through docker compose.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=task_user
DB_PASSWORD=task_password
DB_NAME=task_management

# Connection pool and timeouts
DB_POOL_MAX=10
DB_POOL_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=8000

# --- JWT -------------------------------------------------------------------
# Generate real secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-me-with-a-32-char-minimum-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=task-management-api

# --- Security --------------------------------------------------------------
BCRYPT_ROUNDS=12
# Comma separated list of allowed browser origins. Never use "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:4089,http://localhost:4088
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=5

# --- Pagination ------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# --- Seed data (npm run seed) ---------------------------------------------
SEED_USER_COUNT=12
SEED_TASKS_MIN=20
SEED_TASKS_MAX=30
SEED_PASSWORD=Password123!
