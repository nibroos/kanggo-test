# ---------------------------------------------------------------------------
# The single configuration file for this project.
#
#   cp .env.example .env
#
# It is used by all three ways of running the app:
#
#   docker compose ...      fills the ${...} placeholders in the compose files AND
#                           is passed into the containers (`env_file:`)
#   backend  npm run dev    read by dotenv, as a fallback after backend/.env
#   frontend npm run dev    read by Vite, as a fallback after frontend/.env
#
# Values that must differ inside a container (DB_HOST, DB_PORT) are overridden by
# the compose files themselves, so the host-facing values below stay correct for
# running the apps directly on your machine.
#
# Everything has a working default, so the stack starts even without this file.
# Copy it when you want to change ports or set real secrets.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# API port: where the backend listens, and where Docker publishes it on the host.
PORT=4088
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Host-facing values. Inside Docker the compose files override these with the
# service name and the container port (mysql:3306).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=task_user
DB_PASSWORD=task_password
DB_NAME=task_management
MYSQL_ROOT_PASSWORD=root_password

# Connection pool and timeouts
DB_POOL_MAX=10
DB_POOL_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=8000

# --- JWT -------------------------------------------------------------------
# Generate a different value for each:  openssl rand -hex 32
# The compose files fall back to obvious placeholders. Fine on a laptop; replace
# them anywhere the stack is reachable by anyone else.
JWT_ACCESS_SECRET=replace-me-with-a-32-char-minimum-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-32-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=task-management-api

# --- Security --------------------------------------------------------------
BCRYPT_ROUNDS=12
# Origins allowed to call the API. Never "*".
# 5173 is the Vite dev server, 4089 the built frontend behind nginx.
CORS_ORIGINS=http://localhost:5173,http://localhost:4088,http://localhost:4089
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=5

# --- Pagination ------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# --- Frontend --------------------------------------------------------------
# Where the browser reaches the API.
#   docker-compose.yml      baked into the bundle at build time
#   docker-compose.dev.yml  read by the Vite dev server at start
VITE_API_BASE_URL=http://localhost:4088/api
# Host port for the built frontend behind nginx (docker-compose.yml).
FRONTEND_PORT=4089
# Host port for the Vite dev server (docker-compose.dev.yml, and `npm run dev`).
VITE_PORT=5173
# Set to true if Vite does not notice file edits — common on macOS and Windows,
# where inotify events do not cross a bind mount.
VITE_USE_POLLING=

# --- Seed data (npm run seed) ---------------------------------------------
SEED_USER_COUNT=12
SEED_TASKS_MIN=20
SEED_TASKS_MAX=30
SEED_PASSWORD=Password123!
